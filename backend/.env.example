# PostgreSQL — Neon (https://neon.tech) or local
DATABASE_URL="postgresql://user:password@host/buildtrack?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Server
PORT=8000
NODE_ENV=development

# Origin allowed to call the API (the Vite dev server)
CORS_ORIGIN="http://localhost:5173"

# Seed — password given to every seeded demo account
SEED_PASSWORD="password123"
